{
  "name": "mock-grpc-policy-service",
  "version": "1.1.0",
  "description": "Complete mock gRPC Policy Service v1.1 with TRPO metrics and realistic workflows",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "proto": "npm run proto:build",
    "proto:build": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./generated --grpc_out=grpc_js:./generated --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ../proto ../proto/*.proto",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "docker:build": "docker build -t mock-policy-service .",
    "docker:run": "docker run -p 50051:50051 mock-policy-service"
  },
  "dependencies": {
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@types/node": "^24.2.1",
    "eslint": "^8.45.0",
    "grpc-tools": "^1.12.4",
    "jest": "^29.6.0",
    "nodemon": "^3.0.0",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "keywords": [
    "grpc",
    "policy",
    "mock",
    "trpo",
    "workflow",
    "testing"
  ],
  "author": "Backend API Developer",
  "license": "MIT"
}
