{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["text", "entity_schema_version"],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "domain_hint": {
      "type": "string",
      "enum": ["legal", "medical", "financial", "general"],
      "default": "general"
    },
    "entity_schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$",
      "description": "e.g., 'v2.1'"
    },
    "postproc_thresholds": {
      "type": "object",
      "properties": {
        "min_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.7
        },
        "min_entity_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 2
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}