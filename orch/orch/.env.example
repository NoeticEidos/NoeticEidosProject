# Node Orchestrator Environment Configuration
# Copy this file to .env and update the values for your environment

# ==============================
# Application Configuration
# ==============================
NODE_ENV=development
PORT=3000
GRPC_PORT=50051
API_VERSION=v1
DEBUG=true

# Server Configuration
HOST=localhost
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ==============================
# Database Configuration
# ==============================

# MongoDB
MONGODB_URL=mongodb://admin:admin123@localhost:27017/orchestrator?authSource=admin
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=orchestrator
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=admin123
MONGODB_CONNECTION_POOL_SIZE=10
MONGODB_CONNECTION_TIMEOUT=30000

# ==============================
# Cache Configuration
# ==============================

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=orchestrator:
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# ==============================
# Authentication & Security
# ==============================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# API Keys
API_KEY_HEADER=X-API-Key
ADMIN_API_KEY=your-admin-api-key-change-this

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key
HASH_SALT_ROUNDS=12

# ==============================
# External Services
# ==============================

# AI Services
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Tesseract OCR
TESSERACT_LANG=eng
TESSERACT_CONFIG_PATH=
TESSERACT_CACHE_DIR=./cache/tesseract

# Natural Language Processing
NLP_MODEL=en_core_web_sm
NLP_CACHE_SIZE=1000

# ==============================
# Monitoring & Observability
# ==============================

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=10
LOG_MAX_SIZE=10m

# OpenTelemetry
OTEL_SERVICE_NAME=node-orchestrator
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_EXPORTER_PROMETHEUS_ENDPOINT=http://localhost:9464/metrics
OTEL_RESOURCE_ATTRIBUTES=service.name=node-orchestrator,service.version=1.0.0

# Jaeger Tracing
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832
JAEGER_COLLECTOR_ENDPOINT=http://localhost:14268/api/traces
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Metrics
METRICS_PORT=9464
METRICS_PATH=/metrics
METRICS_ENABLED=true

# Health Checks
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# ==============================
# Message Queue & Workers
# ==============================

# Bull Queue
QUEUE_REDIS_URL=redis://localhost:6379/1
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY=2000

# Worker Configuration
WORKER_THREADS=4
WORKER_MAX_MEMORY=512
WORKER_TIMEOUT=300000

# ==============================
# File Storage & Processing
# ==============================

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,text/plain
UPLOAD_DESTINATION=./uploads
UPLOAD_TEMP_DIR=./temp

# File Processing
PROCESSING_QUEUE_NAME=file-processing
PROCESSING_CONCURRENCY=3
PROCESSING_TIMEOUT=600000

# ==============================
# Development & Testing
# ==============================

# Development
RELOAD_ON_CHANGE=true
SOURCE_MAP_SUPPORT=true
TYPESCRIPT_CHECK=true

# Testing
TEST_DATABASE_URL=mongodb://admin:admin123@localhost:27017/orchestrator_test?authSource=admin
TEST_REDIS_URL=redis://localhost:6379/15
TEST_TIMEOUT=30000
TEST_COVERAGE_THRESHOLD=80

# ==============================
# Docker & Infrastructure
# ==============================

# Docker
COMPOSE_PROJECT_NAME=node-orchestrator
DOCKER_NETWORK=orchestrator-network

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=admin123
GRAFANA_PORT=3001

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=200h

# NGINX
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================
# Feature Flags
# ==============================

# Features
ENABLE_GRPC=true
ENABLE_WEBSOCKETS=true
ENABLE_FILE_PROCESSING=true
ENABLE_AI_SERVICES=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_VALIDATION=true
ENABLE_CORS=true
ENABLE_HELMET=true

# Experimental Features
ENABLE_CLUSTERING=false
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_HTTP2=false

# ==============================
# Performance & Optimization
# ==============================

# Performance
MAX_REQUEST_SIZE=1mb
REQUEST_TIMEOUT=30000
KEEPALIVE_TIMEOUT=5000
HEADER_TIMEOUT=60000

# Memory Management
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=16

# Clustering
CLUSTER_WORKERS=0
CLUSTER_MAX_MEMORY=1gb

# ==============================
# Backup & Recovery
# ==============================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=./backups

# Recovery
AUTO_RECOVERY_ENABLED=true
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BACKOFF_MS=5000

# ==============================
# Notifications & Alerts
# ==============================

# Email (if needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@orchestrator.local

# Slack (if needed)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# ==============================
# Custom Configuration
# ==============================

# Add your custom environment variables here
CUSTOM_FEATURE_ENABLED=false
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your-external-api-key